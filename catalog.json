{
  "service": "demo",
  "base_url": "http://127.0.0.1:4174",
  "allow_domains": ["127.0.0.1"],
  "actions": [
    {"name": "health", "method": "GET", "path": "/api/health", "auth": false,
     "desc": "Service health: storage, notification channels, server time"},
    {"name": "config", "method": "GET", "path": "/api/config", "auth": false,
     "desc": "Public configuration: plans, rates, limits"},
    {"name": "groups_list", "method": "GET", "path": "/api/groups", "auth": true,
     "desc": "Groups of the current user with their join codes"},
    {"name": "group_balance", "method": "GET", "path": "/api/group-balance", "auth": true,
     "desc": "Group balance: collected, spent, remaining"},
    {"name": "group_data", "method": "GET", "path": "/api/group-data", "auth": true,
     "desc": "Group data: members, contributions, transactions"},
    {"name": "receipts", "method": "GET", "path": "/api/receipts", "auth": true,
     "desc": "Receipts: list and fiscal verification status"},
    {"name": "payments_in", "method": "POST", "path": "/api/payments/in", "auth": true,
     "desc": "Incoming payment by group code"},
    {"name": "commission_variants", "method": "GET", "path": "/api/commissions/variants", "auth": true,
     "desc": "Plan and commission options: instant transfers, agent shares"},
    {"name": "votes", "method": "GET", "path": "/api/votes", "auth": true,
     "desc": "Group votes: questions and results"},
    {"name": "orders", "method": "GET", "path": "/api/orders", "auth": true,
     "desc": "Group orders and spending"},
    {"name": "audit", "method": "GET", "path": "/api/audit", "auth": true,
     "desc": "Action log: who changed what and when"},
    {"name": "state", "method": "GET", "path": "/api/state", "auth": true,
     "desc": "Full workspace state, for debugging"}
  ]
}
